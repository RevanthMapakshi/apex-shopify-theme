<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>APEX by The ARC — Limited Drops & Archival Wear</title>
  <meta name="description" content="APEX by THE ARC — Luxury dark streetwear and wearable art house. Zero blank space. Limited drops.">

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:ital,wght@0,400;0,600;0,700;0,800;0,900;1,700;1,900&family=Barlow:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&family=Space+Mono:ital,wght@0,400;0,700;1,400&display=swap" rel="stylesheet">

  {{ content_for_header }}

  {{ 'index.css' | asset_url | stylesheet_tag }}
</head>
<body class="apex-dark">
  <div id="progress-bar"></div>

  {{ content_for_layout }}

  <script>
    // Password Modal Controller
    document.addEventListener('DOMContentLoaded', () => {
      const modal = document.getElementById('password-modal');
      const openBtns = document.querySelectorAll('.js-open-password');
      const closeBtn = document.querySelector('.modal-close');
      const passwordInput = document.querySelector('#password-modal input[type="password"]');

      function openModal() {
        if (!modal) return;
        modal.classList.add('open');
        document.body.style.overflow = 'hidden';
        if (passwordInput) setTimeout(() => passwordInput.focus(), 150);
      }

      function closeModal() {
        if (!modal) return;
        modal.classList.remove('open');
        document.body.style.overflow = '';
      }

      openBtns.forEach(btn => btn.addEventListener('click', (e) => {
        e.preventDefault();
        openModal();
      }));

      if (closeBtn) closeBtn.addEventListener('click', closeModal);

      if (modal) {
        modal.addEventListener('click', (e) => {
          if (e.target === modal) closeModal();
        });
      }

      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && modal && modal.classList.contains('open')) {
          closeModal();
        }
      });

      if (modal && modal.querySelector('.errors, .error')) {
        openModal();
      }
    });
  </script>
</body>
</html>
