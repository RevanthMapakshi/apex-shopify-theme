<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="theme-color" content="#080808">
  <link rel="canonical" href="{{ canonical_url }}">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Archivo:wght@300;400;600;700;800;900&family=Cormorant+Garamond:ital,wght@0,400;0,600;1,400;1,600&family=DM+Mono:wght@300;400;500&family=Syne:wght@700;800;900&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  
  <title>{{ shop.name }} — Private Exhibition & Limited Drops</title>
  <meta name="description" content="APEX by THE ARC — Luxury dark streetwear and wearable art house. Zero blank space. Limited drops.">

  {{ content_for_header }}

  {{ 'apex-password.css' | asset_url | stylesheet_tag }}
</head>
<body class="apex-dark-vault">
  <div class="apex-ambient-glow" aria-hidden="true"></div>
  <div class="apex-grid-mesh" aria-hidden="true"></div>

  {{ content_for_layout }}

  <script src="{{ 'apex-password.js' | asset_url }}" defer="defer"></script>
</body>
</html>
