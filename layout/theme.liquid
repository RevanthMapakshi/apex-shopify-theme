<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>APEX by The ARC | Wear What Others Can't</title>

  {% if settings.favicon != blank %}
    <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    <link rel="shortcut icon" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    <link rel="apple-touch-icon" href="{{ settings.favicon | image_url: width: 180, height: 180 }}">
  {% else %}
    <link rel="icon" type="image/png" sizes="32x32" href="{{ 'favicon-32.png' | asset_url }}">
    <link rel="icon" type="image/svg+xml" href="{{ 'favicon.svg' | asset_url }}">
    <link rel="shortcut icon" href="{{ 'favicon.ico' | asset_url }}">
    <link rel="apple-touch-icon" href="{{ 'favicon-192.png' | asset_url }}">
  {% endif %}

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,300;1,400&family=Inter:wght@300;400;500;600;700&family=DM+Mono:wght@300;400;500&display=swap" rel="stylesheet">

  {{ content_for_header }}

  {{ 'index.css' | asset_url | stylesheet_tag }}
</head>
<body class="apex-light">
  {{ content_for_layout }}

  <script>
    window.APEX_ASSETS = {
      heroBackdropDuo: "{{ 'backdrop-user-black-duo.jpg' | asset_url }}",
      heroBackdropMobile: "{{ 'backdrop-user-black-mobile.jpg' | asset_url }}",
      favicon: "{{ 'favicon.svg' | asset_url }}",
      faviconPng: "{{ 'favicon-32.png' | asset_url }}",
      faviconIco: "{{ 'favicon.ico' | asset_url }}"
    };
  </script>
  <script type="module" src="{{ 'index.js' | asset_url }}"></script>
</body>
</html>
