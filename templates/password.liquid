      </svg>
      <div class="apex-logo-text">
        <span class="apex-logo-name" style="color: #fff;">Apex</span>
        <div class="apex-logo-rule"></div>
        <span class="apex-logo-sub" style="color: #a5a196;">By The ARC</span>
      </div>
    </a>

    <div class="apex-header-right">
      <button type="button" class="apex-nav-objects-btn js-open-password" style="background: rgba(255,255,255,0.06); color: #fff; border-color: rgba(255,255,255,0.18);">
        Unlock Vault 🗝
      </button>
    </div>
  </header>

  <!-- ── COMING SOON HERO STAGE ── -->
  <main class="apex-streetwear-hero" style="flex: 1; min-height: calc(100vh - 165px); padding: 5rem 1.5rem; justify-content: center;">
    <div class="apex-hero-editorial-bg"></div>
    <div class="apex-hero-editorial-overlay"></div>
    <div class="apex-hero-grid-lines"></div>

    <div class="apex-hero-content-editorial" style="max-width: 820px;">
      <!-- Season Pill -->
      <div class="apex-hero-season-pill">
        <span class="apex-hero-live-dot"></span>
        <span>DROP 001 // ARCHIVAL ALLOCATION</span>
      </div>

      <!-- Headline -->
      <h1 class="apex-hero-title-monolithic" style="font-size: clamp(2.4rem, 6.5vw, 4.8rem); line-height: 1.02; letter-spacing: 0.12em; text-align: center;">
        THE DEBUT ARCHIVE
        <span class="apex-hero-sub-title" style="letter-spacing: 0.26em; margin-top: 0.6rem;">JOIN THE WAITLIST // GET NOTIFIED AT LAUNCH</span>
      </h1>

      <!-- Body Subtext -->
      <p class="apex-hero-editorial-tagline" style="font-size: clamp(1.05rem, 1.8vw, 1.3rem); max-width: 640px; line-height: 1.7; margin-top: 0.5rem; color: #d0ccc4;">
        Wearable art engineered for the few who refuse the ordinary.<br>
        Strictly limited numbered pieces. Zero restocks.
      </p>

      <!-- VIP Waitlist / Access Form -->
      <div style="max-width: 580px; width: 100%; margin-top: 1.75rem;">
        {% form 'customer', id: 'ApexComingSoonWaitlist' %}
          <input type="hidden" name="contact[tags]" value="prospect,waitlist,apex_vip,drop_001">

          {% if form.posted_successfully? %}
            <div style="background: rgba(255, 255, 255, 0.08); border: 1px solid var(--red); border-radius: 4px; padding: 22px 28px; color: #fff; font-family: var(--sans); font-size: 0.95rem; line-height: 1.6; text-align: center; box-shadow: 0 12px 35px rgba(0,0,0,0.6);">
              <span style="display: block; font-family: var(--mono); color: var(--red); font-size: 0.72rem; letter-spacing: 0.18em; text-transform: uppercase; margin-bottom: 6px; font-weight: 700;">TRANSMISSION CONFIRMED</span>
              Access requested. Private drop coordinates will be dispatched to your inbox prior to public launch.
            </div>
          {% else %}
            {% if form.errors %}
              <div style="color: var(--red); font-family: var(--mono); font-size: 0.75rem; margin-bottom: 12px; letter-spacing: 0.05em;">
                {{ form.errors | default_errors }}
              </div>
            {% endif %}

            <div style="display: flex; gap: 8px; flex-wrap: wrap; justify-content: center;">
              <input
                type="email"
                name="contact[email]"
                id="WaitlistEmail"
                value="{{ form.email }}"
                placeholder="Enter your email for private drop access"
                style="flex: 1; min-width: 290px; max-width: 380px; background: rgba(255, 255, 255, 0.08); border: 1px solid rgba(255, 255, 255, 0.25); color: #fff; border-radius: 999px; padding: 1.05rem 1.6rem; font-family: var(--sans); font-size: 0.88rem; outline: none; transition: border-color 0.25s, box-shadow 0.25s;"
                required
              >
              <button type="submit" class="apex-hero-btn-primary" style="cursor: pointer; border: none; padding: 1.05rem 2.2rem;">
                REQUEST ACCESS
              </button>
            </div>
          {% endif %}
        {% endform %}
      </div>
    </div>
  </main>

  <!-- ── MINIMALIST EDITORIAL FOOTER ── -->
  <footer style="background: #0a0a0a; color: #fff; padding: 2.5rem 2rem; border-top: 1px solid rgba(255,255,255,0.08); text-align: center;">
    <div style="max-width: 1200px; margin: 0 auto; display: flex; flex-direction: column; align-items: center; gap: 12px;">
      <p style="font-family: var(--serif); font-size: 1.45rem; font-style: italic; letter-spacing: 0.08em; color: #f2efe8; margin: 0;">
        “Wear what others can't.”
      </p>
      <div style="font-family: var(--mono); font-size: 0.65rem; color: #8c8880; letter-spacing: 0.16em; text-transform: uppercase;">
        © {{ 'now' | date: '%Y' }} APEX BY THE ARC • ALL RIGHTS RESERVED
      </div>
    </div>
  </footer>

  <!-- ── PASSWORD ACCESS MODAL SHEET ── -->
  <div class="apex-modal-bg" id="password-modal" style="display: none;">
    <div class="apex-modal-sheet" style="max-width: 460px;">
      <button type="button" class="apex-modal-x" style="position: absolute; top: 1.5rem; right: 1.5rem; background: transparent; border: none; font-size: 1.25rem; cursor: pointer; color: var(--ink-muted);" aria-label="Close modal">✕</button>

      <div style="margin-bottom: 1.5rem;">
        <div class="apex-section-eyebrow">VAULT ACCESS</div>
        <h3 style="font-family: var(--serif); text-transform: uppercase; font-size: 1.75rem; font-weight: 500; margin-bottom: 0.5rem; color: var(--ink);">Enter Storefront</h3>
        <p style="font-family: var(--sans); font-size: 0.82rem; color: var(--ink-muted); line-height: 1.5;">Enter the private access key to browse the complete live catalog and test ordering flows.</p>
      </div>

      {% form 'storefront_password', class: 'apex-modal-form' %}
        {% if form.errors %}
          <div style="color: var(--red); font-family: var(--mono); font-size: 0.72rem; margin-bottom: 1rem;">
            {{ form.errors | default_errors }}
          </div>
        {% endif %}

        <div class="apex-field">
          <label for="password">Access Passphrase</label>
          <input
            type="password"
            name="password"
            id="password"
            placeholder="Enter store access key..."
            autofocus
            autocomplete="current-password"
            required
          >
        </div>

        <button type="submit" name="commit" class="apex-modal-submit">
          Unlock Storefront →
        </button>
      {% endform %}

      <div style="margin-top: 1.5rem; padding-top: 1.25rem; border-top: 1px solid var(--border); display: flex; justify-content: space-between; align-items: center; font-family: var(--mono); font-size: 0.65rem; color: var(--ink-muted);">
        <span>Store Administrator?</span>
        <a href="/admin" style="color: var(--ink); text-decoration: none; font-weight: 600;">Shopify Admin →</a>
      </div>
    </div>
  </div>
</div>
