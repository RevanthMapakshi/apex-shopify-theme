<div class="apex-light" style="min-height: 100vh; display: flex; flex-direction: column; background: #0e0e0e;">
  <!-- ── TOP ANNOUNCEMENT BAR ── -->
  <div class="apex-top-bar">
    <span>DROP 001 // APEX ARCHITECTURAL STREETWEAR • OFFICIAL STORE • PRIVATE EXHIBITION</span>
  </div>

  <!-- ── STICKY EDITORIAL HEADER ── -->
