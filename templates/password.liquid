{% layout 'password' %}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,300;1,400;1,600&family=Inter:wght@200;300;400;500;600;700&family=DM+Mono:wght@300;400;500&family=Jost:ital,wght@0,400;0,500;0,600;0,700;0,800;1,400&display=swap" rel="stylesheet">

<style>
  :root {
    --serif: 'Cormorant Garamond', Georgia, serif;
    --sans: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
    --mono: 'DM Mono', monospace;
    --futura: 'Futura', 'Futura PT', 'Jost', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    --red: #C23B22;
    --red-glow: rgba(194, 59, 34, 0.25);
  }

  @keyframes apexKenBurns {
    0% { transform: scale(1) translate(0, 0); }
    50% { transform: scale(1.05) translate(-1%, -0.8%); }
    100% { transform: scale(1.02) translate(0.8%, 0.5%); }
  }

  @keyframes apexDotPulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.4; transform: scale(0.85); }
  }
  @media (max-width: 768px) {
    .apex-stage-backdrop img {
      object-position: center 20% !important;
      opacity: 0.60 !important;
    }
  }
</style>

<div class="apex-light" style="min-height: 100vh; display: flex; flex-direction: column; background: #F7F6F2; color: #111111; font-family: var(--sans); position: relative; -webkit-font-smoothing: antialiased;">
  <!-- ── ATMOSPHERIC CREAM BACKDROP ── -->
  <div class="apex-stage-backdrop" aria-hidden="true" style="position: fixed; inset: 0; z-index: 0; pointer-events: none; overflow: hidden;">
    <picture>
      <source media="(max-width: 768px)" srcset="{{ 'backdrop-user-black-mobile.jpg' | asset_url }}">
      <img src="{{ 'backdrop-user-black-duo.jpg' | asset_url }}" alt="APEX Streetwear Exhibition" style="position: absolute; top: -5%; left: -5%; width: 110%; height: 110%; object-fit: cover; object-position: center 45%; filter: saturate(0.88) contrast(1.04) brightness(1.02); opacity: 0.52; animation: apexKenBurns 28s ease-in-out infinite alternate; will-change: transform;">
    </picture>
    <div style="position: absolute; inset: 0; background: linear-gradient(180deg, rgba(247, 246, 242, 0.42) 0%, rgba(247, 246, 242, 0.70) 38%, rgba(247, 246, 242, 0.94) 82%, #F7F6F2 100%);"></div>
    <div style="position: absolute; top: 30%; left: 50%; transform: translate(-50%, -50%); width: 700px; height: 450px; background: radial-gradient(ellipse at center, rgba(194, 59, 34, 0.08) 0%, rgba(212, 175, 55, 0.03) 50%, transparent 75%); filter: blur(50px);"></div>
  </div>

  <div style="position: relative; z-index: 10; display: flex; flex-direction: column; min-height: 100vh;">
    <!-- ── TOP ANNOUNCEMENT BAR ── -->
    <div class="apex-top-bar" style="background: #0A0A0A; border-bottom: 1px solid rgba(255, 255, 255, 0.08); color: #C5C2BA; font-family: var(--mono); font-size: 0.62rem; letter-spacing: 0.18em; text-transform: uppercase; text-align: center; padding: 0.55rem 1.5rem; display: flex; justify-content: center; align-items: center; gap: 12px;">
      <span>DROP 001</span>
      <span style="color: var(--red);">✦</span>
      <span>APEX ARCHITECTURAL STREETWEAR</span>
      <span style="color: var(--red);">✦</span>
      <span>OFFICIAL EXHIBITION REGISTER</span>
    </div>

    <!-- ── STICKY EDITORIAL HEADER ── -->
    <header class="apex-header" style="background: rgba(247, 246, 242, 0.88); backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px); border-bottom: 1px solid rgba(17, 17, 17, 0.08); padding: 1.15rem 3.5rem; display: flex; justify-content: space-between; align-items: center; position: sticky; top: 0; z-index: 50;">
      <a href="/" class="apex-logo" style="color: #111111; display: flex; align-items: center; gap: 12px; text-decoration: none; user-select: none;">
        <svg class="apex-logo-icon" viewBox="0 0 2000 2000" fill="currentColor" style="width: 38px; height: 38px; color: #111111; flex-shrink: 0;">
          <path d="M 1022.0,1601.5 L 1018.5,1596.0 L 1015.5,1562.0 L 1001.5,1505.0 L 1000.5,1450.0 L 997.0,1447.5 L 972.0,1450.5 L 929.0,1448.5 L 905.0,1443.5 L 897.5,1434.0 L 895.5,1385.0 L 904.5,1338.0 L 903.5,1294.0 L 915.5,1236.0 L 916.0,1168.5 L 910.0,1170.5 L 866.0,1216.5 L 818.0,1249.5 L 764.0,1307.5 L 726.0,1339.5 L 684.0,1382.5 L 649.0,1405.5 L 620.5,1443.0 L 587.0,1473.5 L 574.5,1480.0 L 610.5,1430.0 L 628.5,1395.0 L 668.5,1351.0 L 737.5,1259.0 L 769.5,1196.0 L 857.5,1073.0 L 856.0,1067.5 L 851.0,1067.5 L 830.0,1074.5 L 821.5,1074.0 L 829.0,1063.5 L 847.5,1050.0 L 846.0,1047.5 L 813.0,1045.5 L 779.0,1050.5 L 745.0,1049.5 L 688.5,1108.0 L 647.5,1173.0 L 640.5,1189.0 L 636.5,1212.0 L 633.0,1215.5 L 528.0,1213.5 L 489.0,1217.5 L 432.0,1217.5 L 393.0,1214.5 L 380.0,1212.5 L 378.5,1204.0 L 398.5,1129.0 L 419.5,1088.0 L 434.5,1048.0 L 327.0,1043.5 L 287.0,1048.5 L 237.0,1041.5 L 222.0,1034.5 L 213.5,1025.0 L 208.5,1007.0 L 208.5,994.0 L 213.5,979.0 L 223.0,968.5 L 250.0,957.5 L 307.0,956.5 L 353.0,949.5 L 374.0,950.5 L 419.0,959.5 L 483.0,953.5 L 510.0,955.5 L 549.5,910.0 L 573.0,890.5 L 720.0,798.5 L 763.0,788.5 L 805.0,770.5 L 879.0,750.5 L 958.0,741.5 L 971.5,668.0 L 972.5,591.0 L 986.5,536.0 L 981.5,473.0 L 998.5,419.0 L 995.5,350.0 L 1000.5,303.0 L 1014.5,252.0 L 1013.5,173.0 L 1014.5,167.0 L 1017.0,164.5 L 1019.5,167.0 L 1022.5,183.0 L 1035.5,252.0 L 1042.5,359.0 L 1054.5,408.0 L 1053.5,452.0 L 1062.5,505.0 L 1063.5,568.0 L 1070.5,604.0 L 1068.5,656.0 L 1077.5,688.0 L 1080.5,732.0 L 1084.0,737.5 L 1189.0,753.5 L 1247.0,779.5 L 1301.0,794.5 L 1346.0,819.5 L 1383.0,828.5 L 1453.0,887.5 L 1496.0,910.5 L 1535.0,952.5 L 1556.0,952.5 L 1584.0,957.5 L 1689.0,951.5 L 1824.0,956.5 L 1840.0,962.5 L 1853.5,973.0 L 1862.5,988.0 L 1863.5,1002.0 L 1850.5,1031.0 L 1830.0,1041.5 L 1793.0,1042.5 L 1760.0,1049.5 L 1723.0,1044.5 L 1664.0,1049.5 L 1611.0,1048.5 L 1608.5,1051.0 L 1609.5,1059.0 L 1628.5,1094.0 L 1641.5,1132.0 L 1651.5,1170.0 L 1655.5,1201.0 L 1655.5,1210.0 L 1652.0,1213.5 L 1620.0,1216.5 L 1559.0,1213.5 L 1408.0,1214.5 L 1395.5,1196.0 L 1383.5,1158.0 L 1364.5,1122.0 L 1352.5,1106.0 L 1328.5,1085.0 L 1314.5,1062.0 L 1303.0,1049.5 L 1296.0,1045.5 L 1261.0,1048.5 L 1191.0,1045.5 L 1189.5,1049.0 L 1214.5,1070.0 L 1205.0,1071.5 L 1181.0,1066.5 L 1179.5,1072.0 L 1187.5,1090.0 L 1272.5,1194.0 L 1290.5,1228.0 L 1315.5,1256.0 L 1353.5,1318.0 L 1378.5,1347.0 L 1397.5,1385.0 L 1428.5,1413.0 L 1452.5,1456.0 L 1474.5,1487.0 L 1468.0,1485.5 L 1450.0,1471.5 L 1413.0,1430.5 L 1386.0,1414.5 L 1361.5,1386.0 L 1332.0,1360.5 L 1282.0,1306.5 L 1251.0,1285.5 L 1187.0,1217.5 L 1129.0,1166.5 L 1126.5,1169.0 L 1127.5,1216.0 L 1135.5,1280.0 L 1137.5,1345.0 L 1148.5,1429.0 L 1142.0,1440.5 L 1130.0,1443.5 L 1046.5,1449.0 L 1032.5,1499.0 L 1036.5,1556.0 L 1022.0,1601.5 Z" />
          <path d="M 762.0,722.5 L 755.0,722.5 L 746.5,715.0 L 717.5,671.0 L 677.5,625.0 L 634.5,557.0 L 597.5,506.0 L 572.5,478.0 L 565.5,467.0 L 564.5,462.0 L 567.0,461.5 L 604.0,488.5 L 711.0,589.5 L 738.0,609.5 L 780.0,648.5 L 827.5,697.0 L 826.0,704.5 L 762.0,722.5 Z" />
          <path d="M 1289.0,715.5 L 1279.0,715.5 L 1242.0,704.5 L 1211.0,699.5 L 1209.5,692.0 L 1227.0,676.5 L 1264.0,657.5 L 1339.0,578.5 L 1382.0,544.5 L 1425.5,501.0 L 1466.0,462.5 L 1466.5,467.0 L 1449.5,494.0 L 1422.5,527.0 L 1404.5,557.0 L 1376.5,598.0 L 1357.5,620.0 L 1342.5,647.0 L 1320.5,673.0 L 1302.5,703.0 L 1289.0,715.5 Z" />
          <path d="M 1534.0,855.5 L 1528.0,855.5 L 1508.0,844.5 L 1494.5,831.0 L 1493.5,826.0 L 1497.0,823.5 L 1718.0,778.5 L 1755.0,775.5 L 1755.5,778.0 L 1749.0,781.5 L 1631.0,818.5 L 1591.0,836.5 L 1560.0,844.5 L 1534.0,855.5 Z" />
          <path d="M 516.0,857.5 L 487.0,855.5 L 456.0,838.5 L 404.0,816.5 L 347.0,800.5 L 300.5,780.0 L 314.0,778.5 L 332.0,782.5 L 364.0,791.5 L 416.0,792.5 L 450.0,804.5 L 487.0,806.5 L 526.0,821.5 L 548.0,824.5 L 549.5,832.0 L 538.0,843.5 L 516.0,857.5 Z" />
        </svg>
        <div class="apex-logo-text" style="display: flex; flex-direction: column; align-items: flex-start;">
          <span class="apex-logo-name" style="font-family: var(--serif); font-size: 1.75rem; font-weight: 500; letter-spacing: 0.22em; line-height: 1; text-transform: uppercase; color: #111111;">Apex</span>
          <div class="apex-logo-rule" style="background: var(--red); width: 100%; height: 1.5px; margin: 4px 0 3px;"></div>
          <span class="apex-logo-sub" style="font-family: var(--mono); font-size: 0.48rem; font-weight: 500; letter-spacing: 0.42em; text-transform: uppercase; color: #78746B;">By The ARC</span>
        </div>
      </a>

      <div class="apex-header-right">
        <button type="button" class="apex-nav-objects-btn js-open-password" style="background: #111111; color: #FFFFFF; border: 1px solid #111111; border-radius: 999px; font-family: var(--mono); font-size: 0.68rem; letter-spacing: 0.12em; padding: 7px 16px; cursor: pointer; text-transform: uppercase; transition: all 0.25s;">
          Unlock Vault 🗝
        </button>
      </div>
    </header>

    <!-- ── COMING SOON HERO STAGE ── -->
    <main class="apex-hero-main" style="flex: 1; display: flex; flex-direction: column; justify-content: center; align-items: center; padding: 3rem 1.5rem 2.25rem; text-align: center;">
      <div style="max-width: 860px; width: 100%; display: flex; flex-direction: column; align-items: center; gap: 1.5rem;">
        <!-- Season Pill -->
        <div class="apex-hero-season-pill" style="display: inline-flex; align-items: center; gap: 8px; background: rgba(255, 255, 255, 0.88); border: 1px solid rgba(17, 17, 17, 0.14); border-radius: 999px; padding: 6px 18px; font-family: var(--mono); font-size: 0.68rem; font-weight: 500; letter-spacing: 0.2em; text-transform: uppercase; color: #3D3A34; backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px); box-shadow: 0 2px 10px rgba(17, 17, 17, 0.05);">
          <span style="width: 7px; height: 7px; border-radius: 50%; background: var(--red); box-shadow: 0 0 10px var(--red); animation: apexDotPulse 2s infinite ease-in-out;"></span>
          <span>DROP 001 // ARCHIVAL ALLOCATION</span>
        </div>

        <!-- Headline (Editorial Serif Cormorant Garamond) & Subtitle (Futura) -->
        <div>
          <h1 class="apex-hero-title-monolithic" style="font-family: var(--serif); font-size: clamp(2.8rem, 7.5vw, 5.4rem); font-weight: 400; line-height: 0.96; letter-spacing: 0.14em; text-align: center; color: #111111; margin: 0.25rem 0 0; text-transform: uppercase;">
            THE DEBUT ARCHIVE
          </h1>
          <span class="apex-hero-sub-title" style="letter-spacing: 0.32em; margin-top: 0.85rem; display: block; font-family: var(--futura); font-weight: 700; font-size: clamp(0.78rem, 1.7vw, 1.05rem); color: var(--red); text-transform: uppercase;">
            JOIN THE WAITLIST // GET NOTIFIED AT LAUNCH
          </span>
        </div>

        <!-- Body Subtext (Futura) -->
        <p style="font-family: var(--futura); font-size: clamp(0.95rem, 1.5vw, 1.15rem); font-weight: 400; line-height: 1.75; color: #3D3A34; max-width: 600px; margin: 0.35rem auto 0; letter-spacing: 0.02em;">
          <span style="display: block;">Wearable art engineered for the few who refuse the ordinary.</span>
          <span style="display: block;">Strictly limited numbered pieces. Zero restocks.</span>
        </p>

        <!-- VIP Waitlist / Access Form -->
        <div style="max-width: 580px; width: 100%; margin-top: 1.25rem;">
          {% form 'customer', id: 'ApexComingSoonWaitlist' %}
            <input type="hidden" name="contact[tags]" value="prospect,waitlist,apex_vip,drop_001">

            {% if form.posted_successfully? %}
              <div style="background: #FFFFFF; border: 1.5px solid var(--red); border-radius: 6px; padding: 22px 28px; color: #111111; font-family: var(--sans); font-size: 0.95rem; line-height: 1.65; text-align: center; box-shadow: 0 14px 40px rgba(17, 17, 17, 0.1);">
                <span style="display: block; font-family: var(--mono); color: var(--red); font-size: 0.7rem; letter-spacing: 0.2em; text-transform: uppercase; margin-bottom: 6px; font-weight: 700;">TRANSMISSION CONFIRMED</span>
                Access requested. Private drop coordinates will be dispatched to your inbox prior to public launch.
              </div>
            {% else %}
              {% if form.errors %}
                <div style="color: var(--red); font-family: var(--mono); font-size: 0.75rem; margin-bottom: 12px; letter-spacing: 0.05em;">
                  {{ form.errors | default_errors }}
                </div>
              {% endif %}

              <div style="display: flex; gap: 10px; flex-wrap: wrap; justify-content: center; width: 100%;">
                <input
                  type="email"
                  name="contact[email]"
                  id="WaitlistEmail"
                  value="{{ form.email }}"
                  placeholder="Enter your email for private drop access"
                  style="flex: 1; min-width: 280px; max-width: 380px; background: #FFFFFF; border: 1.5px solid rgba(17, 17, 17, 0.26); color: #111111; border-radius: 999px; padding: 1.05rem 1.6rem; font-family: var(--sans); font-size: 0.88rem; outline: none; backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px); transition: all 0.25s; box-shadow: 0 2px 8px rgba(17, 17, 17, 0.04);"
                  required
                >
                <button type="submit" class="apex-hero-btn-primary" style="cursor: pointer; border: none; padding: 1.05rem 2.2rem; background: #111111; color: #FFFFFF; border-radius: 999px; font-family: var(--sans); font-weight: 700; font-size: 0.78rem; letter-spacing: 0.16em; text-transform: uppercase; box-shadow: 0 4px 18px rgba(17, 17, 17, 0.18); transition: all 0.25s;">
                  REQUEST ACCESS
                </button>
              </div>
            {% endif %}
          {% endform %}
        </div>

        <!-- Micro Spec Matrix Strip (DM Mono) -->
        <div style="display: flex; justify-content: center; align-items: center; gap: 1.5rem; margin-top: 1.75rem; padding-top: 1.5rem; border-top: 1px solid rgba(17, 17, 17, 0.08); flex-wrap: wrap;">
          <div style="display: flex; flex-direction: column; align-items: center; gap: 2px;">
            <strong style="font-family: var(--mono); font-size: 0.85rem; color: #111111; letter-spacing: 0.06em;">Dual Silhouettes</strong>
            <span style="font-family: var(--mono); font-size: 0.58rem; color: #78746B; letter-spacing: 0.12em; text-transform: uppercase;">Men's & Women's Cuts</span>
          </div>
          <div style="background: rgba(17, 17, 17, 0.14); width: 1px; height: 20px;"></div>
          <div style="display: flex; flex-direction: column; align-items: center; gap: 2px;">
            <strong style="font-family: var(--mono); font-size: 0.85rem; color: #111111; letter-spacing: 0.06em;">Numbered Pieces</strong>
            <span style="font-family: var(--mono); font-size: 0.58rem; color: #78746B; letter-spacing: 0.12em; text-transform: uppercase;">Strictly Limited Drops</span>
          </div>
          <div style="background: rgba(17, 17, 17, 0.14); width: 1px; height: 20px;"></div>
          <div style="display: flex; flex-direction: column; align-items: center; gap: 2px;">
            <strong style="font-family: var(--mono); font-size: 0.85rem; color: #111111; letter-spacing: 0.06em;">Hand-Lasted Soles</strong>
            <span style="font-family: var(--mono); font-size: 0.58rem; color: #78746B; letter-spacing: 0.12em; text-transform: uppercase;">16oz Structured Canvas</span>
          </div>
          <div style="background: rgba(17, 17, 17, 0.14); width: 1px; height: 20px;"></div>
          <div style="display: flex; flex-direction: column; align-items: center; gap: 2px;">
            <strong style="font-family: var(--mono); font-size: 0.85rem; color: #111111; letter-spacing: 0.06em;">240 GSM</strong>
            <span style="font-family: var(--mono); font-size: 0.58rem; color: #78746B; letter-spacing: 0.12em; text-transform: uppercase;">Technical Grid Dobby</span>
          </div>
        </div>
      </div>
    </main>

    <!-- ── MINIMALIST EDITORIAL FOOTER ── -->
    <footer style="background: #EFECE4; color: #111111; padding: 2.2rem 2rem 2.2rem; border-top: 1px solid rgba(17, 17, 17, 0.08); text-align: center;">
      <div style="max-width: 1200px; margin: 0 auto; display: flex; flex-direction: column; align-items: center; gap: 14px;">
        <p style="font-family: var(--serif); font-size: clamp(1.4rem, 2.8vw, 1.9rem); font-style: italic; letter-spacing: 0.08em; color: #111111; margin: 0;">
          “Wear what others can't.”
        </p>
        <div style="display: flex; align-items: center; gap: 16px; flex-wrap: wrap; justify-content: center;">
          <span style="font-family: var(--mono); font-size: 0.64rem; color: #78746B; letter-spacing: 0.16em; text-transform: uppercase;">
            © {{ 'now' | date: '%Y' }} APEX BY THE ARC • ARCHITECTURAL STREETWEAR HOUSE
          </span>
          <span style="color: rgba(17, 17, 17, 0.2);">•</span>
          <a href="https://instagram.com/apexbythearc" target="_blank" rel="noopener" style="font-family: var(--sans); font-size: 0.68rem; letter-spacing: 0.14em; text-transform: uppercase; color: #111111; text-decoration: none;">Instagram ↗</a>
        </div>
      </div>
    </footer>
  </div>

  <!-- ── PASSWORD ACCESS MODAL SHEET ── -->
  <div class="apex-modal-bg" id="password-modal" style="display: none; position: fixed; inset: 0; z-index: 500; background: rgba(17, 17, 17, 0.6); backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px); justify-content: center; align-items: center; padding: 1.5rem;">
    <div class="apex-modal-sheet" style="width: 100%; max-width: 460px; background: #FFFFFF; border: 1px solid rgba(17, 17, 17, 0.26); border-radius: 6px; padding: 2.5rem 2.25rem 2rem; position: relative; box-shadow: 0 24px 60px rgba(17, 17, 17, 0.2);">
      <button type="button" class="apex-modal-x" style="position: absolute; top: 1.25rem; right: 1.25rem; background: none; border: none; font-size: 1.1rem; cursor: pointer; color: #78746B;" aria-label="Close modal">✕</button>

      <div style="margin-bottom: 1.5rem;">
        <span style="font-family: var(--mono); font-size: 0.65rem; letter-spacing: 0.18em; color: var(--red); text-transform: uppercase; display: block; margin-bottom: 0.4rem;">VAULT ACCESS</span>
        <h3 style="font-family: var(--serif); text-transform: uppercase; font-size: 1.85rem; font-weight: 500; letter-spacing: 0.08em; margin-bottom: 0.5rem; color: #111111; line-height: 1.1;">Enter Storefront</h3>
        <p style="font-family: var(--sans); font-size: 0.82rem; color: #78746B; line-height: 1.5;">Enter the private access key to browse the complete live catalog and test ordering flows.</p>
      </div>

      {% form 'storefront_password', class: 'apex-modal-form' %}
        {% if form.errors %}
          <div style="color: var(--red); font-family: var(--mono); font-size: 0.72rem; margin-bottom: 1rem;">
            {{ form.errors | default_errors }}
          </div>
        {% endif %}

        <div class="apex-field" style="display: flex; flex-direction: column; gap: 6px; margin-bottom: 1.25rem; text-align: left;">
          <label for="password" style="font-family: var(--mono); font-size: 0.65rem; letter-spacing: 0.12em; text-transform: uppercase; color: #3D3A34;">Access Passphrase</label>
          <input
            type="password"
            name="password"
            id="password"
            placeholder="Enter store access key..."
            autofocus
            autocomplete="current-password"
            style="background: #F7F6F2; border: 1px solid rgba(17, 17, 17, 0.26); color: #111111; padding: 0.85rem 1rem; border-radius: 4px; font-family: var(--mono); font-size: 0.85rem; outline: none;"
            required
          >
        </div>

        <button type="submit" name="commit" class="apex-modal-submit" style="width: 100%; background: #111111; color: #FFFFFF; border: none; border-radius: 4px; padding: 1rem; font-family: var(--sans); font-size: 0.8rem; font-weight: 700; letter-spacing: 0.16em; text-transform: uppercase; cursor: pointer;">
          Unlock Storefront →
        </button>
      {% endform %}

