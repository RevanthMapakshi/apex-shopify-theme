{% layout 'password' %}

<!-- ── MAIN NAV ── -->
<nav id="main-nav">
  <a href="/" class="nav-logo">APEX <span>BY THE ARC</span></a>
  <div class="nav-links">
    <a href="#preview">SUITE // 001</a>
    <a href="#manifesto">MANIFESTO</a>
    <a href="#" class="nav-cta js-open-password">ENTER VAULT</a>
  </div>
</nav>

<!-- ── HERO ── -->
<header class="hero">
  <div class="hero-main">
    <div class="hero-bg-text">APEX</div>
    
    <div class="hero-eyebrow">
      <div class="hero-eyebrow-line"></div>
      <div class="hero-eyebrow-text">HAUTE COUTURE ✕ ARCHIVAL OUTERWEAR // DROP 001</div>
    </div>

    <h1 class="hero-title">
      <span class="line"><span class="word">WEAR WHAT</span></span>
      <span class="line"><span class="word stroke">OTHERS</span> <span class="word italic">CAN'T.</span></span>
    </h1>

    <div class="hero-bottom">
      <div class="hero-desc">
        Private exhibition and wearable art house. Engineered with <strong>zero blank space</strong>, separate tailored <strong>Men’s ($102) & Women’s ($52)</strong> couture silhouettes, and strictly allocated production runs.
      </div>

      <div class="hero-actions">
        <!-- VIP Waitlist Form -->
        {% form 'customer', class: 'form', id: 'ApexWaitlist' %}
          <input type="hidden" name="contact[tags]" value="prospect,waitlist,apex_vip,drop_001">
          
          {% if form.posted_successfully? %}
            <div style="background: rgba(194,59,34,0.15); border: 1px solid var(--red); padding: 14px 20px; color: var(--white); font-family: 'Space Mono', monospace; font-size: 11px; letter-spacing: 1px; text-transform: uppercase;">
              ✓ Access key reserved. Transmission will be dispatched prior to launch.
            </div>
          {% else %}
            {% if form.errors %}
              <div style="color: var(--red); font-family: 'Space Mono', monospace; font-size: 11px; margin-bottom: 8px;">
                {{ form.errors | default_errors }}
              </div>
            {% endif %}

            <div style="display: flex; gap: 8px; flex-wrap: wrap; align-items: center;">
              <div class="field" style="min-width: 260px; max-width: 340px; border-bottom: 1px solid rgba(var(--white-rgb), .2);">
                <input
                  type="email"
                  name="contact[email]"
                  id="WaitlistEmail"
                  value="{{ form.email }}"
                  placeholder="ENTER EMAIL FOR DROP ACCESS"
                  autocorrect="off"
                  autocapitalize="off"
                  autocomplete="email"
                  required
                >
              </div>
              <button type="submit" class="btn-primary" style="cursor: pointer; border: none;">
                REQUEST ACCESS
              </button>
            </div>
          {% endif %}
        {% endform %}

        <a href="#" class="btn-ghost js-open-password">HAVE A PASSCODE? UNLOCK VAULT</a>
      </div>
    </div>
  </div>

  <!-- ── TICKER ── -->
  <div class="ticker">
    <div class="ticker-inner">
      <span>APEX BY THE ARC</span>
      <span class="sep">/</span>
      <span>ZERO BLANK SPACE</span>
      <span class="sep">/</span>
      <span>HAUTE COUTURE BOMBERS</span>
      <span class="sep">/</span>
      <span>CASABLANCA PALAIS</span>
      <span class="sep">/</span>
      <span>GOTHIC BLOOD ROSE</span>
      <span class="sep">/</span>
      <span>IMPERIAL GOLD DRAGON</span>
      <span class="sep">/</span>
      <span>ARCHITECTURAL BOTTOMS</span>
      <span class="sep">/</span>
      <span>DUAL SILHOUETTE TIERS</span>
      <span class="sep">/</span>
      <span>WEAR WHAT OTHERS CAN'T</span>
      <span class="sep">/</span>
      <span>APEX BY THE ARC</span>
      <span class="sep">/</span>
      <span>ZERO BLANK SPACE</span>
      <span class="sep">/</span>
      <span>HAUTE COUTURE BOMBERS</span>
      <span class="sep">/</span>
      <span>CASABLANCA PALAIS</span>
      <span class="sep">/</span>
      <span>GOTHIC BLOOD ROSE</span>
      <span class="sep">/</span>
      <span>IMPERIAL GOLD DRAGON</span>
      <span class="sep">/</span>
      <span>ARCHITECTURAL BOTTOMS</span>
      <span class="sep">/</span>
      <span>DUAL SILHOUETTE TIERS</span>
      <span class="sep">/</span>
      <span>WEAR WHAT OTHERS CAN'T</span>
      <span class="sep">/</span>
    </div>
  </div>
</header>

<!-- ── ARCHIVAL SUITE PREVIEW ── -->
<main class="shop-container" id="preview">
  <div class="shop-header">
    <div class="shop-eyebrow">PREVIEW // DROP 001</div>
    <h1>THE ARCHIVAL <span>EXHIBITION</span></h1>
    <p>Hand-curated couture outer pieces and statement bottoms scheduled for the inaugural drop.</p>
  </div>

  <div class="products-grid">
    <!-- Card 1: Casablanca Palais -->
    <article class="product-card">
      <div class="product-image">
        <span class="product-category">SILK-TWILL BOMBER</span>
        <div class="product-badge-signature"></div>
        <img src="{{ 'mockups/bomber_casablanca_palais.png' | asset_url }}" alt="APEX Casablanca Palais Bomber" onerror="this.src='{{ 'mockups/arc_apparel_hoodie_1780744731232.png' | asset_url }}'">
      </div>
      <div class="product-info">
        <h3>APEX "Casablanca Palais"</h3>
        <p class="product-desc">Signature brand masterpiece. Mediterranean archway drama, sunset pastel flora, and luxury silk-twill drape.</p>
        <div class="product-footer">
          <div style="font-family: 'Space Mono', monospace; font-size: 11px; color: var(--dim);">MEN'S & WOMEN'S CUTS</div>
          <button type="button" class="buy-btn js-open-password">ALLOCATE</button>
        </div>
      </div>
    </article>

    <!-- Card 2: Gothic Blood Rose -->
    <article class="product-card">
      <div class="product-image">
        <span class="product-category">HAUTE COUTURE</span>
        <div class="product-badge-limited"></div>
        <img src="{{ 'mockups/bomber_gothic_blood_rose.png' | asset_url }}" alt="APEX Gothic Blood Rose Bomber" onerror="this.src='{{ 'mockups/hoodie_arc_black_v2.png' | asset_url }}'">
      </div>
      <div class="product-info">
        <h3>APEX "Gothic Blood Rose"</h3>
        <p class="product-desc">Dark romance tailored in thorns, smoke, and silk-twill drama. Zero blank space across full body canvas.</p>
        <div class="product-footer">
          <div style="font-family: 'Space Mono', monospace; font-size: 11px; color: var(--dim);">MEN'S & WOMEN'S CUTS</div>
          <button type="button" class="buy-btn js-open-password">ALLOCATE</button>
        </div>
      </div>
    </article>

    <!-- Card 3: Imperial Gold Dragon -->
    <article class="product-card">
      <div class="product-image">
        <span class="product-category">SUKAJAN COUTURE</span>
        <div class="product-badge-limited"></div>
        <img src="{{ 'mockups/bomber_imperial_gold_dragon.png' | asset_url }}" alt="APEX Imperial Gold Dragon Bomber" onerror="this.src='{{ 'mockups/hoodie_arc_red.png' | asset_url }}'">
      </div>
      <div class="product-info">
        <h3>APEX "Imperial Gold Dragon"</h3>
        <p class="product-desc">Gilded dragon scales, oriental mythology, and high-contrast gold luster tailored in relaxed and contour cuts.</p>
        <div class="product-footer">
          <div style="font-family: 'Space Mono', monospace; font-size: 11px; color: var(--dim);">MEN'S & WOMEN'S CUTS</div>
          <button type="button" class="buy-btn js-open-password">ALLOCATE</button>
        </div>
      </div>
    </article>

    <!-- Card 4: The Monolith Shorts -->
    <article class="product-card">
      <div class="product-image">
        <span class="product-category">240 GSM BOTTOMS</span>
        <div class="product-badge-limited"></div>
        <img src="{{ 'mockups/shorts/01_The_Monolith_mockup.png' | asset_url }}" alt="APEX The Monolith Shorts" onerror="this.src='{{ 'mockups/shorts/03_Liquid_Marble_Void_Smoke_mockup.png' | asset_url }}'">
      </div>
      <div class="product-info">
        <h3>APEX "The Monolith"</h3>
        <p class="product-desc">Stealth active modular shorts with 240 GSM heavyweight structure, deep zip utility pockets, and brutalist aesthetic.</p>
        <div class="product-footer">
          <div style="font-family: 'Space Mono', monospace; font-size: 11px; color: var(--dim);">MODULAR EDITION</div>
          <button type="button" class="buy-btn js-open-password">ALLOCATE</button>
        </div>
      </div>
    </article>
  </div>

  <!-- Trust Bar -->
  <div class="shop-trust-bar" id="manifesto">
    <div class="trust-item">
      <span style="color: var(--red); font-size: 14px;">✦</span> DUAL SILHOUETTE TIERS // TAILORED MEN'S & WOMEN'S CUTS
    </div>
    <div class="trust-item">
      <span style="color: var(--red); font-size: 14px;">✦</span> ZERO BLANK SPACE // 100% CANVASSING
    </div>
    <div class="trust-item">
      <span style="color: var(--red); font-size: 14px;">✦</span> ARCHIVAL PRODUCTION // STRICT ALLOCATION
    </div>
  </div>
</main>

<!-- ── FOOTER ── -->
<footer>
  <a href="/" class="footer-logo">APEX <span>BY THE ARC</span></a>
  <div class="footer-copy">© {{ 'now' | date: '%Y' }} APEX BY THE ARC. ARCHIVAL WEARABLE ART.</div>
  <ul class="footer-links">
    <li><a href="https://instagram.com/apexbythearc" target="_blank" rel="noopener">INSTAGRAM ↗</a></li>
    <li><a href="#" class="js-open-password">VAULT LOGIN</a></li>
  </ul>
</footer>

<!-- ── STOREFRONT PASSWORD MODAL ── -->
<div class="modal-overlay" id="password-modal" role="dialog" aria-modal="true">
  <div class="modal">
    <button type="button" class="modal-close" aria-label="Close modal">✕</button>
    <div class="modal-header">
      <div class="modal-meta">
        <span class="modal-tag">RESTRICTED ACCESS</span>
        <span class="modal-date">STOREFRONT VAULT</span>
      </div>
      <h2 class="modal-title">ENTER <span>ACCESS KEY</span></h2>
    </div>
    <div class="modal-body">
      <p style="color: var(--dim); margin-bottom: 24px; font-size: 14px;">
        Private staging area. Enter the authorized master passphrase to unlock the live storefront.
      </p>

      {% form 'storefront_password', class: 'form' %}
        {% if form.errors %}
          <div style="color: var(--red); font-family: 'Space Mono', monospace; font-size: 11px; margin-bottom: 16px;">
            {{ form.errors | default_errors }}
          </div>
        {% endif %}

        <div class="field" style="margin-bottom: 24px; border-bottom: 1px solid rgba(var(--white-rgb), .2);">
          <input
            type="password"
            name="password"
            id="password"
            placeholder="ENTER STORE ACCESS KEY..."
            autofocus
            autocomplete="current-password"
            required
          >
        </div>

        <button type="submit" name="commit" class="form-btn">
          UNLOCK VAULT →
        </button>
      {% endform %}

      <div style="margin-top: 36px; padding-top: 20px; border-top: 1px solid var(--border); display: flex; justify-content: space-between; align-items: center; font-family: 'Space Mono', monospace; font-size: 10px; color: var(--dim);">
        <span>Store Owner?</span>
        <a href="/admin" style="color: var(--white); text-decoration: none; border-bottom: 1px solid var(--dim);">Admin Dashboard →</a>
      </div>
    </div>
  </div>
</div>
