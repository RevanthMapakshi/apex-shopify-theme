        </span>
        <div class="apex-brand-text">
          <span class="apex-brand-title">APEX</span>
          <span class="apex-brand-sub">BY THE ARC</span>
        </div>
      </a>

      <div class="apex-header-status">
        <span class="apex-status-pill">
          <span class="apex-pulse-dot"></span>
          VAULT RESTRICTED // DROP 001
        </span>
      </div>

      <div class="apex-header-actions">
        <button type="button" class="apex-key-btn" id="openPasswordModal" aria-haspopup="dialog">
          <span class="apex-key-icon">🔒</span>
          <span>ENTER VAULT</span>
        </button>
      </div>
    </div>
  </header>

  <!-- ── MAIN EXHIBITION HERO ── -->
  <main class="apex-hero-section">
    <div class="apex-container">
      <div class="apex-hero-badge-wrap">
        <span class="apex-badge">HAUTE COUTURE ✕ DARK LUXURY</span>
        <span class="apex-badge-sep">//</span>
        <span class="apex-badge-code">EDITION SPEC // 2026</span>
      </div>

      <h1 class="apex-hero-headline">
        <span class="line-1">WEAR WHAT</span>
        <span class="line-2">OTHERS CAN'T.</span>
      </h1>

      <p class="apex-hero-manifesto">
        Private exhibition and archival wearable art house. Engineered with zero blank space, separate tailored Men’s & Women’s couture silhouettes, and strictly allocated production runs.
      </p>

      <!-- ── VIP WAITLIST EMAIL CAPTURE ── -->
      <div class="apex-access-box">
        <div class="apex-access-header">
          <span class="apex-access-label">REQUEST PRIVATE ACCESS</span>
          <span class="apex-access-meta">DROP 001 ALLOCATION // VIP PRIORITY</span>
        </div>

        {% form 'customer', class: 'apex-waitlist-form', id: 'ApexCustomerWaitlist' %}
          <input type="hidden" name="contact[tags]" value="prospect,waitlist,apex_vip,drop_001">
          
          {% if form.posted_successfully? %}
            <div class="apex-form-success" role="alert">
              <span class="apex-success-icon">✓</span>
              <div>
                <strong>ACCESS KEY RESERVED.</strong>
                <p>You are registered on the private allocation register. Expect direct transmission prior to launch.</p>
              </div>
            </div>
          {% else %}
            {% if form.errors %}
              <div class="apex-form-error" role="alert">
                <span>{{ form.errors | default_errors }}</span>
              </div>
            {% endif %}

            <div class="apex-input-row">
              <div class="apex-input-wrap">
                <input
                  type="email"
                  name="contact[email]"
                  id="ApexWaitlistEmail"
                  class="apex-email-input"
                  value="{{ form.email }}"
                  placeholder="ENTER YOUR EMAIL FOR DROP NOTICE..."
                  autocorrect="off"
                  autocapitalize="off"
                  autocomplete="email"
                  required
                >
                <span class="apex-input-glow"></span>
              </div>
              <button type="submit" class="apex-submit-btn">
                <span>RESERVE ACCESS</span>
                <svg viewBox="0 0 16 16" fill="none" class="apex-btn-arrow"><path d="M1 8h14M9 2l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </button>
            </div>
            <p class="apex-input-note">Guaranteed zero spam. Exclusive allocation notices only.</p>
          {% endif %}
        {% endform %}
      </div>

      <!-- ── SPEC MATRIX ── -->
      <div class="apex-spec-grid">
        <div class="apex-spec-item">
          <span class="apex-spec-num">01</span>
          <span class="apex-spec-title">DUAL SILHOUETTE TIERS</span>
          <p class="apex-spec-desc">Separate tailored cuts for Men's & Women's outerwear contours.</p>
        </div>
        <div class="apex-spec-item">
          <span class="apex-spec-num">02</span>
          <span class="apex-spec-title">ZERO BLANK SPACE</span>
          <p class="apex-spec-desc">Every sleeve, collar, and lining is precision canvas engineered.</p>
        </div>
        <div class="apex-spec-item">
          <span class="apex-spec-num">03</span>
          <span class="apex-spec-title">ARCHIVAL ALLOCATION</span>
          <p class="apex-spec-desc">Ultra-limited drops. Once retired, never reissued.</p>
        </div>
      </div>
    </div>
  </main>

  <!-- ── KINETIC BRUTALIST TICKER ── -->
  <div class="apex-ticker-wrap" aria-hidden="true">
    <div class="apex-ticker-track">
      <div class="apex-ticker-content">
        <span>APEX BY THE ARC</span>
        <span class="sym">✦</span>
        <span>ZERO BLANK SPACE</span>
        <span class="sym">✦</span>
        <span>HAUTE COUTURE BOMBERS</span>
        <span class="sym">✦</span>
        <span>CASABLANCA PALAIS</span>
        <span class="sym">✦</span>
        <span>GOTHIC BLOOD ROSE</span>
        <span class="sym">✦</span>
        <span>IMPERIAL GOLD DRAGON</span>
        <span class="sym">✦</span>
        <span>SAMURAI ONI</span>
        <span class="sym">✦</span>
        <span>ARCHITECTURAL BOTTOMS</span>
        <span class="sym">✦</span>
        <span>WEAR WHAT OTHERS CAN'T</span>
        <span class="sym">✦</span>
      </div>
      <div class="apex-ticker-content" aria-hidden="true">
        <span>APEX BY THE ARC</span>
        <span class="sym">✦</span>
        <span>ZERO BLANK SPACE</span>
        <span class="sym">✦</span>
        <span>HAUTE COUTURE BOMBERS</span>
        <span class="sym">✦</span>
        <span>CASABLANCA PALAIS</span>
        <span class="sym">✦</span>
        <span>GOTHIC BLOOD ROSE</span>
        <span class="sym">✦</span>
        <span>IMPERIAL GOLD DRAGON</span>
        <span class="sym">✦</span>
        <span>SAMURAI ONI</span>
        <span class="sym">✦</span>
        <span>ARCHITECTURAL BOTTOMS</span>
        <span class="sym">✦</span>
        <span>WEAR WHAT OTHERS CAN'T</span>
        <span class="sym">✦</span>
      </div>
    </div>
  </div>

  <!-- ── ARCHIVAL EXHIBITION TEASER CARDS ── -->
  <section class="apex-exhibition-section">
    <div class="apex-container">
      <div class="apex-section-header">
        <div>
          <span class="apex-label-dim">PREVIEW // DROP 001</span>
          <h2 class="apex-section-title">THE ARCHIVAL SUITE</h2>
        </div>
        <div class="apex-section-tagline">
          <span>CURATED HAUTE COUTURE LINEUP</span>
        </div>
      </div>

      <div class="apex-gallery-grid">
        <!-- Card 1: Casablanca Palais -->
        <article class="apex-card">
          <div class="apex-card-badge">SIGNATURE PIECE // 05</div>
          <div class="apex-card-media">
            <div class="apex-art-placeholder apex-art-casablanca">
              <span class="apex-art-symbol">🏛️</span>
              <span class="apex-art-watermark">CASABLANCA PALAIS</span>
            </div>
          </div>
          <div class="apex-card-body">
            <div class="apex-card-meta">
              <span class="apex-card-type">SILK-TWILL BOMBER JACKET</span>
              <span class="apex-card-cut">MEN'S & WOMEN'S CUTS</span>
            </div>
            <h3 class="apex-card-title">APEX "Casablanca Palais"</h3>
            <p class="apex-card-tagline">Mediterranean archway drama, pastel sunset flora, and palace garden decadence.</p>
          </div>
        </article>

        <!-- Card 2: Gothic Blood Rose -->
        <article class="apex-card">
          <div class="apex-card-badge">COUTURE 01</div>
          <div class="apex-card-media">
            <div class="apex-art-placeholder apex-art-gothic">
              <span class="apex-art-symbol">🥀</span>
              <span class="apex-art-watermark">GOTHIC BLOOD ROSE</span>
            </div>
          </div>
          <div class="apex-card-body">
            <div class="apex-card-meta">
              <span class="apex-card-type">HAUTE COUTURE BOMBER</span>
              <span class="apex-card-cut">MEN'S & WOMEN'S CUTS</span>
            </div>
            <h3 class="apex-card-title">APEX "Gothic Blood Rose"</h3>
            <p class="apex-card-tagline">Dark romance tailored in thorns, smoke, and crimson silk-twill drama.</p>
          </div>
        </article>

        <!-- Card 3: Imperial Gold Dragon -->
        <article class="apex-card">
          <div class="apex-card-badge">COUTURE 02</div>
          <div class="apex-card-media">
            <div class="apex-art-placeholder apex-art-dragon">
              <span class="apex-art-symbol">🐉</span>
              <span class="apex-art-watermark">IMPERIAL GOLD DRAGON</span>
            </div>
          </div>
          <div class="apex-card-body">
            <div class="apex-card-meta">
              <span class="apex-card-type">SUKAJAN BOMBER V2</span>
              <span class="apex-card-cut">MEN'S & WOMEN'S CUTS</span>
            </div>
            <h3 class="apex-card-title">APEX "Imperial Gold Dragon"</h3>
            <p class="apex-card-tagline">Gilded dragon scales, oriental clouds, and high-contrast gold twill luster.</p>
          </div>
        </article>

        <!-- Card 4: The Monolith Shorts -->
        <article class="apex-card">
          <div class="apex-card-badge">BOTTOMS 01</div>
          <div class="apex-card-media">
            <div class="apex-art-placeholder apex-art-monolith">
              <span class="apex-art-symbol">⬛</span>
              <span class="apex-art-watermark">THE MONOLITH</span>
            </div>
          </div>
          <div class="apex-card-body">
            <div class="apex-card-meta">
              <span class="apex-card-type">240 GSM ACTIVE SHORTS</span>
              <span class="apex-card-cut">MODULAR EDITION</span>
            </div>
            <h3 class="apex-card-title">APEX "The Monolith"</h3>
            <p class="apex-card-tagline">Stealth brutalism, deep utility zip pockets, and architectural silhouette drape.</p>
          </div>
        </article>
      </div>
    </div>
  </section>

  <!-- ── FOOTER ── -->
  <footer class="apex-footer">
    <div class="apex-container">
      <div class="apex-footer-inner">
        <div class="apex-footer-brand">
          <span class="apex-f-title">APEX BY THE ARC</span>
          <span class="apex-f-desc">DARK LUXURY // WEARABLE ART // ARCHIVAL OUTERWEAR</span>
        </div>
        <div class="apex-footer-links">
          <a href="https://instagram.com/apexbythearc" target="_blank" rel="noopener" class="apex-footer-link">
            <span>INSTAGRAM ↗</span>
          </a>
          <button type="button" class="apex-footer-link" id="footerPasswordTrigger">
            <span>VAULT LOGIN</span>
          </button>
        </div>
      </div>
      <div class="apex-footer-bottom">
        <span>© {{ 'now' | date: '%Y' }} APEX by THE ARC. ALL RIGHTS RESERVED.</span>
        <span>PRIVATE EXHIBITION STAGING</span>
      </div>
    </div>
  </footer>

  <!-- ── SECRET VAULT PASSWORD MODAL ── -->
  <div class="apex-modal-backdrop" id="passwordModal" role="dialog" aria-modal="true" aria-hidden="true">
    <div class="apex-modal-card">
      <button type="button" class="apex-modal-close" id="closePasswordModal" aria-label="Close modal">✕</button>

      <div class="apex-modal-header">
        <span class="apex-modal-pill">STORE ACCESS</span>
        <h2 class="apex-modal-title">UNLOCK VAULT</h2>
        <p class="apex-modal-desc">Enter the private access key to preview the full storefront catalog.</p>
      </div>

      {% form 'storefront_password', class: 'apex-modal-form', id: 'ApexStorefrontPasswordForm' %}
        {% if form.errors %}
          <div class="apex-form-error" role="alert">
            <span>{{ form.errors | default_errors }}</span>
          </div>
        {% endif %}

        <div class="apex-modal-input-wrap">
          <label for="password" class="apex-visually-hidden">Storefront Password</label>
          <input
            type="password"
            name="password"
            id="password"
            class="apex-modal-input"
            placeholder="ENTER STORE ACCESS KEY..."
            autofocus
            autocomplete="current-password"
            required
          >
        </div>

        <button type="submit" name="commit" class="apex-modal-btn">
          <span>ENTER STOREFRONT</span>
          <svg viewBox="0 0 16 16" fill="none" class="apex-btn-arrow"><path d="M1 8h14M9 2l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
      {% endform %}

      <div class="apex-modal-footer">
        <span>Store Administrator?</span>
        <a href="/admin" class="apex-admin-link">Shopify Admin Login →</a>
      </div>
    </div>
  </div>
</div>
