<div id="root"></div>

<div class="apex-shopify-app-blocks-container" style="display: contents;">
  {% for block in section.blocks %}
    {% case block.type %}
      {% when '@app' %}
        {% render block %}
    {% endcase %}
  {% endfor %}
</div>

{% schema %}
{
  "name": "Product Information",
  "tag": "section",
  "class": "section-main-product",
  "blocks": [
    {
      "type": "@app"
    }
  ],
  "settings": []
}
{% endschema %}
